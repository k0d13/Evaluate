# @defaultRequired=false @defaultSensitive=false
# ---

# @type=enum(development, test, production)
NODE_ENV=development

# Public origin of the website. On Vercel it falls back to the deployment URL
VERCEL_URL=

# @type=url
WEBSITE_URL=if($VERCEL_URL, concat("https://", $VERCEL_URL))

# @sensitive @required
PISTON_API_KEY=

POSTHOG_KEY=

DISCORD_CLIENT_ID=

DISCORD_PUBLIC_KEY=

# @sensitive
DISCORD_CLIENT_SECRET=

# @sensitive
DISCORD_TOKEN=
