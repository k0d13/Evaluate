{
  "name": "discord-bot",
  "version": "4.1.0",
  "description": "Run code snippets directly in your Discord server with the Evaluate bot!",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "pnpm tsup",
    "check": "tsc --noEmit",
    "check:env": "varlock load",
    "extract": "saykit extract",
    "prebuild": "saykit compile",
    "precheck": "saykit compile",
    "predev": "saykit compile"
  },
  "dependencies": {
    "@buape/carbon": "^0.17.0",
    "@evaluate/logger": "workspace:^",
    "@saykit/carbon": "^0.12.0",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.53.1",
    "piston.ts": "workspace:^",
    "posthog-node": "^5.63.0",
    "saykit": "^0.12.0"
  },
  "devDependencies": {
    "@saykit/config": "^0.12.0",
    "@saykit/format-po": "^0.12.0",
    "@saykit/transform-js": "^0.12.0",
    "tsup": "^9.0.0",
    "unplugin-saykit": "^0.12.0",
    "varlock": "^1.24.0"
  }
}
