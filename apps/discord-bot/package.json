{
  "name": "discord-bot",
  "version": "4.1.0",
  "description": "Run code snippets directly in your Discord server with the Evaluate bot!",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm tsup",
    "check": "tsc --noEmit",
    "check:env": "varlock load",
    "prebuild": "sayable extract && sayable compile"
  },
  "dependencies": {
    "@buape/carbon": "^0.13.0",
    "@evaluate/logger": "workspace:^",
    "@sayable/carbon": "0.0.0-alpha.4",
    "@sayable/react": "0.0.0-alpha.6",
    "date-fns": "^4.1.0",
    "es-toolkit": "^1.40.0",
    "piston.ts": "workspace:^",
    "posthog-node": "^5.5.1",
    "sayable": "0.0.0-alpha.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@sayable/config": "0.0.0",
    "@sayable/format-po": "0.0.0",
    "tsup": "^8.5.0",
    "unplugin-sayable": "0.0.0-alpha.4",
    "varlock": "^1.24.0"
  }
}
