{
  "name": "website",
  "version": "2.0.0",
  "description": "Run code snippets in any programming language with Evaluate!",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "NODE_ENV=production varlock run -- next build",
    "check": "tsc --noEmit",
    "check:env": "varlock load",
    "dev": "varlock run -- next dev --turbo",
    "extract": "saykit extract",
    "prebuild": "saykit compile",
    "precheck": "saykit compile",
    "predev": "saykit compile",
    "start": "NODE_ENV=production varlock run -- next start"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/view": "^6.43.15",
    "@evaluate/components": "workspace:^",
    "@evaluate/logger": "workspace:^",
    "@hookform/resolvers": "^7.0.3",
    "@saykit/react": "^0.12.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-devtools": "^5.106.1",
    "@uiw/codemirror-extensions-langs": "^4.25.12",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vercel/speed-insights": "^2.1.0",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "discord-bot": "workspace:^",
    "dompurify": "^3.4.17",
    "embla-carousel-autoplay": "^8.6.0",
    "es-toolkit": "^1.53.1",
    "file-saver": "^2.0.5",
    "is-mobile": "^5.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.69.0",
    "material-icon-theme": "^5.40.0",
    "next": "16.4.5",
    "next-themes": "npm:@wits/next-themes@^0.2.16",
    "piston.ts": "workspace:^",
    "posthog-js": "^1.447.1",
    "react": "^19.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "saykit": "^0.12.0",
    "server-only": "^0.0.1",
    "virtual-file-explorer-backend": "workspace:^",
    "vscode-icons-js": "^11.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.5",
    "@saykit/config": "^0.12.0",
    "@saykit/format-json": "^0.12.0",
    "@saykit/transform-js": "^0.12.0",
    "@saykit/transform-jsx": "^0.12.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.3.0",
    "babel-plugin-saykit": "^0.12.0",
    "tailwindcss": "^4.3.4",
    "varlock": "^1.24.0"
  }
}
