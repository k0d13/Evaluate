{
  "name": "browser-extension",
  "version": "0.3.0",
  "description": "Run any code snippet you come across on the web with the Evaluate browser extension!",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "pnpm run \"/build:.*/\"",
    "build:chrome": "NODE_ENV=production varlock run -- vite build --config vite.config.chrome.ts",
    "build:firefox": "NODE_ENV=production varlock run -- vite build --config vite.config.firefox.ts && NODE_ENV=production varlock run -- ff-zip || true",
    "check": "tsc --noEmit",
    "check:env": "varlock load",
    "dev": "pnpm run \"/dev:.*/\"",
    "dev:chrome": "varlock run -- vite --config vite.config.chrome.ts",
    "dev:firefox": "varlock run -- vite --config vite.config.firefox.ts"
  },
  "dependencies": {
    "@evaluate/components": "workspace:^",
    "@evaluate/logger": "workspace:^",
    "@evaluate/style": "workspace:^",
    "lucide-react": "^1.69.0",
    "piston.ts": "workspace:^",
    "posthog-js": "^1.447.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/generator": "^8.1.0",
    "@babel/parser": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "@babel/types": "^8.1.0",
    "@crxjs/vite-plugin": "3.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "varlock": "^1.24.0",
    "vite": "8.3.6",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
