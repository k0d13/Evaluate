{
  "name": "evaluate",
  "private": true,
  "workspaces": [
    "apps/*",
    "bots/*",
    "extensions/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "check": "turbo run check",
    "check:env": "pnpm -r --parallel check:env",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "dev": "pnpm run \"/dev:.*/\"",
    "dev:apps": "turbo run dev --filter=\"./apps/*\"",
    "dev:packages": "turbo watch build --filter=\"./packages/*\"",
    "fix": "pnpm run fix:lint && pnpm run fix:format",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "graph": "pnpx nx@18 graph",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@evaluate/scripts": "workspace:^",
    "@types/node": "^26.6.6",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "varlock": "^1.24.0"
  },
  "packageManager": "pnpm@10.18.3"
}
